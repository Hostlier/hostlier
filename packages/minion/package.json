{
  "name": "@fused/minion",
  "version": "0.1.0",
  "description": "Fused-style server actions and optional UI with gRPC Engine execution and Hostlier deployment",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    },
    "./client": {
      "types": "./dist/src/client.d.ts",
      "import": "./dist/src/client.js"
    },
    "./server": {
      "types": "./dist/src/server.d.ts",
      "import": "./dist/src/server.js"
    },
    "./grpc": {
      "types": "./dist/src/grpc.d.ts",
      "import": "./dist/src/grpc.js"
    },
    "./build": {
      "types": "./dist/src/build.d.ts",
      "import": "./dist/src/build.js"
    }
  },
  "hostlier": { "minionBuildProtocol": 1 },
  "bin": {
    "minion": "dist/src/cli.js"
  },
  "files": [
    "dist/src",
    "README.md",
    "examples",
    "skills"
  ],
  "bundleDependencies": [
    "@fused/runtime"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/copy-protocol.mjs",
    "test": "npm run build && node --test dist/test/*.test.js",
    "prepack": "node scripts/prepack.mjs",
    "pack": "node scripts/pack.mjs"
  },
  "dependencies": {
    "@fused/runtime": "file:../vendor/fused-runtime/fused-runtime-0.1.0.tgz",
    "@grpc/grpc-js": "1.14.6",
    "@grpc/proto-loader": "0.8.1",
    "esbuild": "0.28.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "typescript": "6.0.3",
    "zod": "4.6.6"
  },
  "devDependencies": {
    "@types/jsdom": "21.1.7",
    "@types/node": "25.9.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "jsdom": "26.1.0"
  }
}
